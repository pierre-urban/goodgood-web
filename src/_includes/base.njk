<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {% endif %}GOODGOOD</title>
<meta name="description" content="GOODGOOD — curator of creative culture. Offline experiences, trips, food, film and community.">
<link rel="icon" href="/assets/logo-white.png">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<nav>
  <a class="wordmark" href="/">GOODGOOD</a>
  <ul>
    <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>EVENTS</a></li>
    <li><a href="/archive/" {% if page.url == "/archive/" %}aria-current="page"{% endif %}>ARCHIVE</a></li>
    <li><a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>ABOUT&nbsp;US</a></li>
    <li><a class="icon" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2.5" y="2.5" width="19" height="19" rx="5.2"/>
        <circle cx="12" cy="12" r="4.6"/>
        <circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"/>
      </svg>
    </a></li>
  </ul>
</nav>

{{ content | safe }}

{% if not hideFooter %}
<footer>
  <span>&copy;GOODGOOD</span>
  <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.2"/>
      <circle cx="12" cy="12" r="4.6"/>
      <circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"/>
    </svg>
  </a>
</footer>
{% endif %}

<script>
// Newsletter: the Substack form is cropped at its own size (--nl-w) and scaled
// to fill our capsule; ?nl-ladeni shows the whole form and the crop.
document.querySelectorAll('[data-nl]').forEach(function (nl) {
  if (location.search.indexOf('nl-ladeni') > -1) nl.classList.add('nl-debug');
  var box = nl.querySelector('.nl-box');
  var fit = function () {
    var full = parseFloat(getComputedStyle(nl).getPropertyValue('--nl-w')) || 364;
    nl.style.setProperty('--nl-s', String(box.clientWidth / full));
  };
  fit();
  window.addEventListener('resize', fit);
});
// Once someone clicks into the Substack field, hide our placeholder over it.
window.addEventListener('blur', function () {
  setTimeout(function () {
    var f = document.activeElement;
    if (f && f.tagName === 'IFRAME' && f.closest('[data-nl]')) f.closest('[data-nl]').classList.add('nl-active');
  });
});
// After sending, Substack swaps its form for a confirmation we can't see into.
// Sign of that: their frame loads a new page; once the visitor has used the
// form, that shows our thank-you instead. ?nl-ladeni lists what the frame does.
(function () {
  var debug = location.search.indexOf('nl-ladeni') > -1;
  var log = function (text) {
    if (!debug) return;
    var box = document.getElementById('nl-log');
    if (!box) {
      box = document.createElement('pre');
      box.id = 'nl-log';
      box.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99;max-width:96vw;max-height:40vh;overflow:auto;background:#fff;color:#000;font:12px/1.4 monospace;padding:8px;white-space:pre-wrap';
      document.body.appendChild(box);
    }
    box.textContent += new Date().toLocaleTimeString() + '  ' + text + '\n';
  };
  var thank = function (nl, why) {
    log('thank-you (' + why + ')');
    if (!debug && nl.classList.contains('nl-active')) nl.classList.add('nl-sent');
  };
  document.querySelectorAll('[data-nl]').forEach(function (nl) {
    var frame = nl.querySelector('iframe');
    var loads = 0;
    frame.addEventListener('load', function () {
      loads++;
      log('frame load #' + loads);
      if (loads > 1) thank(nl, 'reload');
    });
    window.addEventListener('message', function (e) {
      if (e.source !== frame.contentWindow) return;
      var data = e.data;
      try { data = typeof data === 'string' ? data : JSON.stringify(data); } catch (err) {}
      // only logged for now: until we know what Substack sends, a message
      // while typing must not hide the field
      log('message: ' + String(data).slice(0, 300));
    });
  });
})();
</script>
</body>
</html>
