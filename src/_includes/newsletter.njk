{% if settings.substack_url %}
<!-- official Substack form, cropped to just the field and button (.nl-crop);
     goodgood.cz/?nl-ladeni shows the whole form and the crop for tuning -->
<div class="nl" data-nl>
  <div class="nl-box">
    <div class="nl-crop">
      <iframe src="{{ settings.substack_url }}/embed" title="Newsletter GOODGOOD" scrolling="no" frameborder="0"></iframe>
    </div>
    <!-- our placeholder and button drawn over theirs; clicks pass through to Substack -->
    <span class="nl-ph" aria-hidden="true">Your email</span>
    <span class="nl-btn" aria-hidden="true">SUBSCRIBE</span>
  </div>
  <p class="nl-thanks" role="status">DĚKUJEME — JSTE NA SEZNAMU<br>THANK&nbsp;YOU — YOU&rsquo;RE&nbsp;ON&nbsp;THE&nbsp;LIST</p>
</div>
{% endif %}
