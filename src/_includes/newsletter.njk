{% if settings.substack_url %}
{#- The email goes to Substack the same way their own signup form sends it,
    from the visitor's browser into a hidden frame, so Substack's pages
    (and the new tab it would open) never show. -#}
<form data-newsletter action="{{ settings.substack_url }}/api/v1/free?nojs=true" method="post" target="nl-sink">
  <input type="email" name="email" required placeholder="Your email" aria-label="Your email" autocomplete="email">
  <input type="hidden" name="first_url">
  <input type="hidden" name="current_url">
  <input type="hidden" name="source" value="embed">
  <button type="submit">SUBSCRIBE</button>
</form>
<p class="join-done" role="status" hidden>DĚKUJEME — JSTE NA SEZNAMU<br>THANK&nbsp;YOU — YOU&rsquo;RE&nbsp;ON&nbsp;THE&nbsp;LIST</p>
<iframe name="nl-sink" title="" hidden sandbox></iframe>
{% endif %}
