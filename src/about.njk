---
layout: base.njk
title: About us
permalink: /about/
---
<main class="page">
  <div class="about-grid">
    <div class="about-left">
      <svg class="about-arrow" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="9" aria-hidden="true">
        <path d="M18 18 L78 78"/><path d="M78 30 L78 78 L30 78"/>
      </svg>
      <div class="about-copy">
        <p>{{ about.intro }}</p>
        <p>{{ about.outro }}</p>
      </div>
      {% for p in about.pillars %}
      <div class="about-block"><h3>{{ p.title }}</h3><p>{{ p.text }}</p></div>
      {% endfor %}
      <div class="connect">
        <h2>LET'S CONNECT</h2>
        <div class="join">
          <p>JOIN&nbsp;US&nbsp;FOR&nbsp;THE&nbsp;NEXT&nbsp;ADVENTURE</p>
          <form data-newsletter>
            <input type="email" required placeholder="Your email" aria-label="Your email">
            <button type="submit">SUBSCRIBE</button>
          </form>
        </div>
      </div>
    </div>
    <div class="about-right">
      {% for ph in about.photos %}<img loading="lazy" src="{{ ph }}" alt="GOODGOOD">{% endfor %}
    </div>
  </div>
</main>
