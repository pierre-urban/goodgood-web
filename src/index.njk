<header class="hero">
  <img class="poster" src="/assets/bg-poster.jpg" alt="">
  <video autoplay muted loop playsinline poster="/assets/bg-poster.jpg">
    <source src="/assets/bg-video.webm" type="video/webm">
    <source src="/assets/bg-video.mp4" type="video/mp4">
  </video>
  <div class="hero-inner">
    <img class="hero-logo" src="/assets/logo-white.png" alt="GOODGOOD">
    <div class="join">
      <p>JOIN&nbsp;US&nbsp;FOR&nbsp;THE&nbsp;NEXT&nbsp;ADVENTURE</p>
      <form data-newsletter>
        <input type="email" required placeholder="Your email" aria-label="Your email">
        <button type="submit">SUBSCRIBE</button>
      </form>
    </div>
  </div>
</header>
